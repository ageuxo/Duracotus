{
  "name": "duracotus",
  "version": "0.1.0",
  "description": "Orbit calculator with WebGL visualiser",
  "license": "LGPL-3.0-or-later",
  "author": "ageuxo",
  "type": "module",
  "main": "src/main.ts",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --outfile=dist/index.js --loader:.vert=text --loader:.frag=text --loader:.png=file",
    "dev": "esbuild src/main.ts --bundle --outfile=dist/index.js --watch --servedir=dist --sourcemap --loader:.vert=text --loader:.frag=text --loader:.png=file"
  },
  "devDependencies": {
    "esbuild": "0.27.3"
  },
  "dependencies": {
    "gl-matrix": "^3.4.4"
  }
}
