{
  "compilerOptions": {
    "target": "es2023",
    "rootDir": "./src",
    "outDir": "./dist",
    "module": "commonjs",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": true
  },
  "display": "Recommended",
  "$schema": "https://www.schemastore.org/tsconfig",
  "include": ["src/**/*"]
}